# Soldex Frontend Environment Variables

# Solana network
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
NEXT_PUBLIC_PROGRAM_ID=REPLACE_WITH_DEPLOYED_PROGRAM_ID

# Rust engine WebSocket
NEXT_PUBLIC_ENGINE_WS_URL=ws://localhost:9000/ws

# Polymarket (optional — engine proxies by default)
NEXT_PUBLIC_POLYMARKET_API=https://clob.polymarket.com
