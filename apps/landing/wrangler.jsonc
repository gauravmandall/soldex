{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "main": ".open-next/worker.js",
    "name": "soldex-landing",
    "compatibility_date": "2026-01-20",
    "compatibility_flags": [
      "nodejs_compat"
    ],
    "assets": {
      "directory": ".open-next/assets",
      "binding": "ASSETS"
    },
    "routes": [
      {
        "pattern": "soldex.fi",
        "custom_domain": true
      },
      {
        "pattern": "www.soldex.fi",
        "custom_domain": true
      }
    ]
  }